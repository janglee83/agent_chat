NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
# Directory with the built frontend (relative to the backend cwd or absolute).
STATIC_DIR=../frontend/dist

# PostgreSQL (docker compose: `pnpm infra:up`)
DATABASE_URL=postgresql://agent_chat:agent_chat@localhost:5432/agent_chat?schema=public

# Redis
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=agent-chat:

# OpenTelemetry → grafana/otel-lgtm (`pnpm docker:up:obs`). Set OTEL_SDK_DISABLED=true to turn off.
OTEL_SERVICE_NAME=agent-chat
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=local
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
