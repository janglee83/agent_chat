{
  "name": "backend",
  "version": "0.0.0",
  "private": true,
  "description": "Agent chat API (NestJS)",
  "license": "UNLICENSED",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "prisma generate && nest build",
    "db:check": "prisma validate && prisma format --check",
    "db:deploy": "prisma migrate deploy",
    "db:format": "prisma format",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "dev": "nest start --watch --env-file .env --exec \"node --import ./dist/instrumentation.js\"",
    "dev:docker": "nest start --watch --exec \"node --import ./dist/instrumentation.js\"",
    "postinstall": "prisma generate",
    "lint": "eslint . --max-warnings=0 --cache",
    "lint:fix": "eslint . --fix --cache",
    "start": "nest start --env-file .env",
    "start:debug": "nest start --debug --watch --env-file .env",
    "start:prod": "node --import ./dist/instrumentation.js dist/main.js",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config ./vitest.e2e.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/serve-static": "^12.0.0",
    "@nestjs/terminus": "^12.1.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/auto-instrumentations-node": "0.80.0",
    "@opentelemetry/instrumentation": "0.222.0",
    "@opentelemetry/sdk-node": "0.222.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@prisma/instrumentation": "7.10.0",
    "import-in-the-middle": "3.5.2",
    "nestjs-cls": "7.0.1",
    "nestjs-pino": "5.3.1",
    "pg": "^8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "redis": "^6.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@agent-chat/eslint-config": "workspace:*",
    "@agent-chat/tsconfig": "workspace:*",
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.6",
    "@nestjs/testing": "^12.1.2",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.3",
    "dotenv": "^18.0.5",
    "eslint": "^10.11.0",
    "pino-pretty": "13.1.3",
    "prisma": "7.10.0",
    "supertest": "^7.3.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
